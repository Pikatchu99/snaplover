# Modèle — copier sur le VPS vers /etc/cloudflared/config.yml et remplacer
# <TUNNEL_ID> par l'UUID affiché après `cloudflared tunnel create` (voir
# docs/DEPLOY.md). Aucun secret dans ce fichier : le fichier de credentials
# du tunnel (~/.cloudflared/<TUNNEL_ID>.json) est généré localement par
# `cloudflared tunnel login`/`create`, jamais committé.
tunnel: snaplover
credentials-file: /root/.cloudflared/<TUNNEL_ID>.json

ingress:
  # 3002, pas 3000 : port hôte choisi pour éviter les autres services déjà
  # en place sur ce VPS partagé (voir deploy/docker-compose.yml) — ajuster
  # ici si ce port venait lui aussi à être pris.
  - hostname: snaplover.hbdwall.xyz
    service: http://localhost:3002
  - hostname: snaplover-signaling.hbdwall.xyz
    service: http://localhost:8080
  # Previews par PR (voir docs/PREVIEW.md) — UN SEUL wildcard couvre à la
  # fois pr-<N>.snaplover-preview.hbdwall.xyz (web) et
  # pr-<N>-ws.snaplover-preview.hbdwall.xyz (signaling), puisque les deux
  # sont un seul niveau sous snaplover-preview.hbdwall.xyz. Volontairement
  # scopé sous "snaplover-preview" (pas un wildcard sur tout hbdwall.xyz) :
  # ce VPS héberge d'autres projets sur ce même domaine, un wildcard racine
  # capturerait leurs sous-domaines aussi. Route vers Traefik (port 3999),
  # jamais directement vers un conteneur de PR — voir
  # deploy/preview/docker-compose.yml.
  - hostname: "*.snaplover-preview.hbdwall.xyz"
    service: http://localhost:3999
  - service: http_status:404
