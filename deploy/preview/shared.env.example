# Copier sur le VPS vers ~/snaplover/preview/shared.env — mêmes valeurs que
# ~/snaplover/web.env (voir deploy/web.env.example) : les creds TURN sont
# réutilisées telles quelles pour les previews, pas besoin d'un jeu séparé.
# Jamais committé (voir .gitignore).

STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

TURN_URLS=turn:standard.relay.metered.ca:80

TURN_USERNAME=
TURN_CREDENTIAL=

TURN_SECRET=
